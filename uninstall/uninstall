#!/bin/bash
# Dashboard - Deinstallation
#
# LoxBerry entfernt beim Deinstallieren nur die Ordner des Plugins selbst:
# config/plugins/<x>/, data/plugins/<x>/, bin/, templates/ und beide
# webfrontend/-Ordner (gemessen in sbin/plugininstall.pl, purge_installation,
# Schritt 7). Was NEBEN diesen Ordnern liegt, bleibt liegen - und genau
# dorthin gehoert alles, was ein Update ueberstehen soll:
#
#   config/plugins/<x>.backup.json           Zweitschrift der Einstellungen
#   config/plugins/<x>.backup.dashboard.json Zweitschrift der Einstellungen
#   config/plugins/<x>.backup.seiten.json    die ganze Handarbeit
#   config/plugins/<x>.backup.zugang.json    Benutzer und Kennwort
#   data/plugins/<x>.upgrade_sicherung       der Verlauf waehrend des Updates
#   config/plugins/<x>.sicherungen/          der Sicherungsverlauf (seit 0.9.26)
#   <jeweils>.alt                            beiseitegelegt von preinstall.sh
#                                            und preupgrade.sh (Entscheidung 1)
#
# Dieses Skript ist das EINZIGE, das LoxBerry bei der Deinstallation
# ausfuehrt: plugininstall.pl liest nur uninstall/uninstall* (am Geraet am
# 18.09.2026 gemessen, Regeln/06). Bis 0.9.24 lag daneben ein uninstall.sh im
# Wurzelverzeichnis mit derselben Arbeit, und dieser Kommentar sagte, welches
# der beiden laufe, sei nicht nachgemessen. Seit 0.9.25 ist uninstall.sh
# entfernt (I7, Durchgang 29.09.2026). Das Skript ist mehrfach ausfuehrbar,
# ein zweiter Lauf findet nichts mehr und meldet 0.
#
# Aufruf: <ZUFALLSKENNUNG> <NAME> <FOLDER> <VERSION> <BASEFOLDER> <TEMPFOLDER>
# ACHTUNG: $1 ist NICHT der Arbeitsordner, sondern eine zehnstellige
# Zufallskennung. Gearbeitet wird deshalb mit $3 und $5.

# Aufwaerts suchen, bis ein Verzeichnis gefunden ist, das nachweislich eine
# LoxBerry-Wurzel IST. Eine feste Zahl '..' waere nur die naechste Wette:
# je nach Ablageort sind es drei Ebenen oder vier.
#
# Drittes Merkmal ist config/system/general.json: ein LoxBerry hat sie immer,
# ein Rest aus Pruefstaenden nie (Regeln/06). Ohne sie loeschte dieses Skript
# in einem fremden Baum mit config/plugins und data/plugins die Zweitschriften
# und die .upgrade_sicherung (gemessen am 18.09.2026 in WSL,
# Pruefung-Dashboard-0.9.24, Fall F5).
lb_wurzel_suchen() {
    v=$(cd "$(dirname "$(readlink -f "$0")")" 2>/dev/null && pwd)
    i=0
    while [ -n "$v" ] && [ "$v" != "/" ] && [ $i -lt 8 ]; do
        if [ -d "$v/config/plugins" ] && [ -d "$v/data/plugins" ] \
           && [ -f "$v/config/system/general.json" ]; then
            echo "$v"; return 0
        fi
        v=$(dirname "$v"); i=$((i + 1))
    done
    return 1
}

UN_FOLDER="${3:-dashboard}"
UN_BASE="${5:-$LBHOMEDIR}"
if [ -z "$UN_BASE" ] || [ ! -d "$UN_BASE" ]; then
    UN_BASE=$(lb_wurzel_suchen)
fi
if [ -z "$UN_BASE" ] || [ ! -d "$UN_BASE" ]; then
    echo "<INFO> Kein Wurzelverzeichnis gefunden - nichts abgeraeumt."
    exit 0
fi

# Zuerst anhalten - sonst schreibt der Dienst noch in Ordner, die gleich
# verschwinden, und legt dabei genau die Dateien wieder an, die hier weg
# sollen.
DIENST="$UN_BASE/bin/plugins/$UN_FOLDER/dienst.sh"
if [ -x "$DIENST" ]; then
    # I8 (Durchgang 29.09.2026): "angehalten" nur nach Erfolg. Bis 0.9.25
    # stand die Meldung bedingungslos da, auch wenn dienst.sh mit
    # "FEHLER: Dienst laeuft weiter" und 1 zurueckkam. Mit Zeitgrenze, damit
    # die Deinstallation nicht haengt (Fehlerklasse 6).
    if command -v timeout >/dev/null 2>&1; then UN_T="timeout 60"; else UN_T=""; fi
    UN_AUS=$($UN_T "$DIENST" stop 2>&1)
    UN_RC=$?
    UN_AUS=$(printf '%s' "$UN_AUS" | tr '\n' ' ')
    if [ "$UN_RC" = 0 ]; then
        echo "<INFO> Dienst: $UN_AUS"
    else
        echo "<WARNING> Der Dienst liess sich nicht anhalten (Rueckgabewert $UN_RC): $UN_AUS"
    fi
fi

# Der Punkt hinter dem Ordnernamen ist Absicht: er trennt den Nachbarn vom
# Ordner. Das Sternchen trifft deshalb nur die eigenen Zweitschriften.
ANZAHL=0
for f in "$UN_BASE/config/plugins/$UN_FOLDER".backup.*; do
    [ -e "$f" ] || continue
    rm -f "$f" && ANZAHL=$((ANZAHL + 1))
done
if [ -e "$UN_BASE/data/plugins/$UN_FOLDER.upgrade_sicherung" ]; then
    rm -rf "$UN_BASE/data/plugins/$UN_FOLDER.upgrade_sicherung" && ANZAHL=$((ANZAHL + 1))
fi
# Entscheidung 1: die von preinstall.sh/preupgrade.sh beiseitegelegte
# .upgrade_sicherung.alt raeumt die Deinstallation mit ab. (Die .alt der
# Zweitschriften trifft schon das Muster <ordner>.backup.* oben.) Gemessen
# vorher (Fall J des Installer-Pruefers): sie blieb liegen.
if [ -e "$UN_BASE/data/plugins/$UN_FOLDER.upgrade_sicherung.alt" ]; then
    rm -rf "$UN_BASE/data/plugins/$UN_FOLDER.upgrade_sicherung.alt" && ANZAHL=$((ANZAHL + 1))
fi
# S5 (0.9.26): der Sicherungsverlauf liegt als Ordner neben dem
# Konfigurationsordner und traegt Aktionstoken und Zugangsdaten. Er geht mit,
# samt der von preinstall.sh beiseitegelegten .alt. Geloescht wird nur bei
# einem Ordnernamen ohne Schraegstrich und ohne '..'; ein Verweis an seiner
# Stelle wird als Verweis entfernt, sein Ziel bleibt. Gezaehlt wird, was
# danach wirklich fehlt.
case "$UN_FOLDER" in
    ''|*/*|*..*)
        echo "<WARNING> Unzulaessiger Ordnername '$UN_FOLDER' - der Sicherungsverlauf wurde nicht entfernt." ;;
    *)
        for UN_V in "$UN_BASE/config/plugins/$UN_FOLDER.sicherungen" \
                    "$UN_BASE/config/plugins/$UN_FOLDER.sicherungen.alt"; do
            if [ -e "$UN_V" ] || [ -L "$UN_V" ]; then
                rm -rf "${UN_V:?}" 2>/dev/null
                if [ -e "$UN_V" ] || [ -L "$UN_V" ]; then
                    echo "<WARNING> $UN_V liess sich nicht entfernen - bitte von Hand loeschen (Zugangsdaten)."
                else
                    ANZAHL=$((ANZAHL + 1))
                fi
            fi
        done ;;
esac
# Die Marke einer abgebrochenen Aktualisierung liegt ebenfalls neben dem
# Datenordner und geht mit ihm nicht weg. Bliebe sie liegen, sperrte sie Dienst
# und Oberflaeche einer spaeteren Neuinstallation bis zu einer Stunde lang
# (Pruefung-Dashboard-0.9.23, Fall C9a).
if [ -e "$UN_BASE/data/plugins/$UN_FOLDER.upgrade_laeuft" ]; then
    rm -f "$UN_BASE/data/plugins/$UN_FOLDER.upgrade_laeuft" \
        && echo "<INFO> Die Marke einer nicht beendeten Aktualisierung wurde entfernt."
fi

echo "<OK> $ANZAHL Datei(en)/Ordner mit Konfiguration, Handarbeit und Zugangsdaten entfernt."
exit 0
